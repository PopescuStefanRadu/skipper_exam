# Production settings for deploy/compose.yaml. Copy to .env and fill in.
# See docs/DEPLOYMENT.md for what each one is and how to get it.

# The public address, served over HTTPS by your reverse proxy.
APP_URL=https://skipperexam.esrp.ro
# Where the app listens for the reverse proxy.
APP_BIND=127.0.0.1:8080

# Generate with `openssl rand -hex 16`.
POSTGRES_PASSWORD=

# Sign-in through Authentik: this app's OAuth2/OpenID provider (confidential client,
# redirect URI https://skipperexam.esrp.ro/auth/callback, subject mode "user UUID").
OIDC_ISSUER_URL=https://auth.esrp.ro/application/o/skipper-exam/
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Account deletion: an Authentik API token allowed to view and delete users, and the
# group this app's sign-ups join. Only users in that group and no other are deleted.
AUTHENTIK_URL=https://auth.esrp.ro
AUTHENTIK_API_TOKEN=
AUTHENTIK_APP_GROUP=skipper-exam

# Backups: one folder per day, the newest BACKUP_KEEP_DAYS kept, taken at BACKUP_HOUR (TZ).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
TZ=Europe/Bucharest

# Images: a tag published by CI (latest, or a commit sha for a fixed version).
IMAGE_TAG=latest
