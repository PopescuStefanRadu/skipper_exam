# Production settings for deploy/compose.yaml. Copy to .env and fill in.
# See docs/DEPLOYMENT.md for what each one is and how to get it.

# The public address, served over HTTPS by your reverse proxy.
APP_URL=https://skipperexam.esrp.ro
# Where the app listens for the reverse proxy.
APP_BIND=127.0.0.1:8080

# Secrets: generate each with `openssl rand -hex 16` (CIPHER_SECRET must be exactly 32 characters).
POSTGRES_PASSWORD=
COOKIE_SECRET=
CIPHER_SECRET=

# Email for password reset codes, e.g. smtps://user:password@smtp.example.com:465
# (URL-encode special characters in the user and password).
SMTP_URI=
MAIL_FROM=no-reply@esrp.ro

# Google sign-in: an OAuth client of type "Web application" in Google Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backups: one folder per day, the newest BACKUP_KEEP_DAYS kept, taken at BACKUP_HOUR (TZ).
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=3
TZ=Europe/Bucharest

# Images: a tag published by CI (latest, or a commit sha for a fixed version).
IMAGE_TAG=latest
