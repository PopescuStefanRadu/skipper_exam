# Kratos configuration template. scripts/stack.sh replaces __APP_URL__ with the
# stack's address and writes the result to .stack/kratos.yml.
version: v1.3.1

dsn: postgres://skipper_exam:skipper_exam@db:5432/kratos?sslmode=disable

serve:
  public:
    # The backend serves Kratos's public API under /.ory on the app's own origin.
    base_url: __APP_URL__/.ory/
  admin:
    base_url: http://kratos:4434/

selfservice:
  default_browser_return_url: __APP_URL__/
  allowed_return_urls:
    - __APP_URL__/
  methods:
    password:
      enabled: true
      config:
        # Tests and home servers must not depend on an external service.
        haveibeenpwned_enabled: false
  flows:
    login:
      ui_url: __APP_URL__/autentificare
    registration:
      ui_url: __APP_URL__/inregistrare
      # Email and password on one form.
      enable_legacy_one_step: true
      after:
        password:
          hooks:
            - hook: session
    settings:
      ui_url: __APP_URL__/setari
    recovery:
      enabled: true
      use: code
      ui_url: __APP_URL__/recuperare
    verification:
      enabled: false
    error:
      ui_url: __APP_URL__/eroare
    logout:
      after:
        default_browser_return_url: __APP_URL__/autentificare

identity:
  default_schema_id: default
  schemas:
    - id: default
      url: file:///etc/config/kratos/identity.schema.json

courier:
  smtp:
    connection_uri: smtp://mailpit:1025/?disable_starttls=true
    from_address: no-reply@skipper-exam.local
    from_name: Examen CAA

secrets:
  cookie:
    - __COOKIE_SECRET__
  cipher:
    - __CIPHER_SECRET__
