# Kratos configuration template, the same for the test stack and production.
# entrypoint.sh fills in the __NAME__ placeholders from environment variables when
# the container starts (see docs/DEPLOYMENT.md). The database address (DSN) and the
# SMTP server (COURIER_SMTP_CONNECTION_URI) are read by Kratos from its environment.
version: v1.3.1

serve:
  public:
    # The backend serves Kratos's public API under /.ory on the app's own origin.
    base_url: __APP_URL__/.ory/
  admin:
    base_url: http://kratos:4434/

selfservice:
  default_browser_return_url: __APP_URL__/
  allowed_return_urls:
    - __APP_URL__/
    # The Android app: Google sign-in returns to it through this link.
    - ro.skipperexam.app://auth
  methods:
    password:
      enabled: true
      config:
        # Signing up must not depend on an external service.
        haveibeenpwned_enabled: false
    oidc:
      enabled: true
      config:
        providers:
          # Google, through OpenID Connect discovery at the issuer: in production
          # https://accounts.google.com; in the test stack a mock server.
          - id: google
            provider: generic
            label: Google
            client_id: __OIDC_CLIENT_ID__
            client_secret: __OIDC_CLIENT_SECRET__
            issuer_url: __OIDC_ISSUER_URL__
            mapper_url: file:///etc/config/kratos/oidc.google.jsonnet
            scope:
              - openid
              - email
  flows:
    login:
      ui_url: __APP_URL__/autentificare
    registration:
      ui_url: __APP_URL__/inregistrare
      # Email and password on one form.
      enable_legacy_one_step: true
      after:
        password:
          hooks:
            - hook: session
        oidc:
          hooks:
            - hook: session
    settings:
      ui_url: __APP_URL__/setari
    recovery:
      enabled: true
      use: code
      ui_url: __APP_URL__/recuperare
    verification:
      enabled: false
    error:
      ui_url: __APP_URL__/eroare
    logout:
      after:
        default_browser_return_url: __APP_URL__/autentificare

identity:
  default_schema_id: default
  schemas:
    - id: default
      url: file:///etc/config/kratos/identity.schema.json

courier:
  # Romanian emails (courier-templates/).
  template_override_path: /etc/config/kratos/courier-templates/
  smtp:
    from_address: __MAIL_FROM__
    from_name: Examen CAA

secrets:
  cookie:
    - __COOKIE_SECRET__
  cipher:
    - __CIPHER_SECRET__
